{
  "name": "cafe87-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate --schema=../prisma/schema.prisma && tsc",
    "start": "node dist/index.js",
    "db:generate": "npx prisma generate --schema=../prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=../prisma/schema.prisma",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "*",
    "bcryptjs": "*",
    "cors": "*",
    "dotenv": "*",
    "express": "*",
    "jsonwebtoken": "*",
    "prisma": "*",
    "tsx": "*",
    "typescript": "*",
    "zod": "*"
  }
}
