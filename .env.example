# Auth
JWT_SECRET="change-this-to-a-long-random-string-in-production"

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS="http://localhost:5173,https://your-cafe87-domain.com"

# Frontend API URL (leave blank for Vercel serverless — it proxies /api automatically)
# For separate backend deployments set: VITE_API_URL=https://api.your-domain.com/api
VITE_API_URL=

# Web3Forms contact form key
VITE_WEB3FORMS_ACCESS_KEY=your_key_here
